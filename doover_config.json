{
    "smi2m_display": {
        "key": null,
        "name": "smi2m_display",
        "display_name": "SMI2-M Display",
        "type": "DEV",
        "visibility": "PUB",
        "allow_many": true,
        "description": "Drive an akYtec SMI2-M RS485 7-segment display over Modbus RTU",
        "long_description": "README.md",
        "depends_on": [
            "modbus_interface"
        ],
        "owner_org_key": "",
        "image_name": "ghcr.io/getdoover/akytec-smi2m-display:main",
        "container_registry_profile_key": "",
        "build_args": "--platform linux/amd64,linux/arm64",
        "staging_config": {},
        "config_schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "",
            "title": "$default",
            "type": "object",
            "properties": {
                "modbus_config": {
                    "title": "Modbus Config",
                    "x-name": "modbus_config",
                    "x-hidden": false,
                    "type": "object",
                    "x-required": true,
                    "x-position": 0,
                    "properties": {
                        "bus_type": {
                            "enum": [
                                "serial",
                                "tcp"
                            ],
                            "title": "Bus Type",
                            "x-name": "bus_type",
                            "x-hidden": false,
                            "type": [
                                "string",
                                "null"
                            ],
                            "x-required": false,
                            "default": "serial",
                            "x-position": 1
                        },
                        "name": {
                            "title": "Name",
                            "x-name": "name",
                            "x-hidden": false,
                            "type": [
                                "string",
                                "null"
                            ],
                            "x-required": false,
                            "default": "default",
                            "x-position": 2
                        },
                        "serial_port": {
                            "title": "Serial Port",
                            "x-name": "serial_port",
                            "x-hidden": false,
                            "type": [
                                "string",
                                "null"
                            ],
                            "x-required": false,
                            "default": "/dev/ttyAMA0",
                            "x-position": 3
                        },
                        "serial_baud": {
                            "title": "Serial Baud",
                            "x-name": "serial_baud",
                            "x-hidden": false,
                            "type": [
                                "integer",
                                "null"
                            ],
                            "x-required": false,
                            "default": 9600,
                            "x-position": 4
                        },
                        "serial_method": {
                            "enum": [
                                "rtu",
                                "ascii",
                                "socket",
                                "tls"
                            ],
                            "title": "Serial Method",
                            "x-name": "serial_method",
                            "x-hidden": false,
                            "type": [
                                "string",
                                "null"
                            ],
                            "x-required": false,
                            "default": "rtu",
                            "x-position": 5
                        },
                        "serial_data_bits": {
                            "title": "Serial Data Bits",
                            "x-name": "serial_data_bits",
                            "x-hidden": false,
                            "type": [
                                "integer",
                                "null"
                            ],
                            "x-required": false,
                            "default": 8,
                            "x-position": 6
                        },
                        "serial_parity": {
                            "enum": [
                                "None",
                                "Even",
                                "Odd"
                            ],
                            "title": "Serial Parity",
                            "x-name": "serial_parity",
                            "x-hidden": false,
                            "type": [
                                "string",
                                "null"
                            ],
                            "x-required": false,
                            "default": "None",
                            "x-position": 7
                        },
                        "serial_stop_bits": {
                            "title": "Serial Stop Bits",
                            "x-name": "serial_stop_bits",
                            "x-hidden": false,
                            "type": [
                                "integer",
                                "null"
                            ],
                            "x-required": false,
                            "default": 1,
                            "x-position": 8
                        },
                        "serial_timeout": {
                            "title": "Serial Timeout",
                            "x-name": "serial_timeout",
                            "x-hidden": false,
                            "type": [
                                "number",
                                "null"
                            ],
                            "x-required": false,
                            "default": 0.3,
                            "x-position": 9
                        },
                        "tcp_uri": {
                            "title": "TCP URI",
                            "x-name": "tcp_uri",
                            "x-hidden": false,
                            "type": [
                                "string",
                                "null"
                            ],
                            "x-required": false,
                            "default": "127.0.0.1:5000",
                            "x-position": 10
                        },
                        "tcp_timeout": {
                            "title": "TCP Timeout",
                            "x-name": "tcp_timeout",
                            "x-hidden": false,
                            "type": [
                                "number",
                                "null"
                            ],
                            "x-required": false,
                            "default": 2.0,
                            "x-position": 11
                        }
                    },
                    "additionalElements": true,
                    "required": [],
                    "x-collapsible": true,
                    "x-defaultCollapsed": false
                },
                "slave_id": {
                    "title": "Slave ID",
                    "x-name": "slave_id",
                    "x-hidden": false,
                    "type": [
                        "integer",
                        "null"
                    ],
                    "x-required": false,
                    "description": "Modbus address of the display (its 'Address in Slave mode' parameter). Factory default is 1.",
                    "default": 1,
                    "x-position": 1,
                    "minimum": 1,
                    "maximum": 255
                },
                "default_colour": {
                    "enum": [
                        "green",
                        "red",
                        "yellow"
                    ],
                    "title": "Default Colour",
                    "x-name": "default_colour",
                    "x-hidden": false,
                    "type": [
                        "string",
                        "null"
                    ],
                    "x-required": false,
                    "description": "Colour used when a set_value call does not specify one.",
                    "default": "green",
                    "x-position": 2
                },
                "brightness": {
                    "title": "Brightness",
                    "x-name": "brightness",
                    "x-hidden": false,
                    "type": [
                        "integer",
                        "null"
                    ],
                    "x-required": false,
                    "description": "Panel brightness, in percent.",
                    "default": 75,
                    "x-position": 3,
                    "minimum": 0,
                    "maximum": 100
                },
                "blank_timeout": {
                    "title": "Blank Timeout",
                    "x-name": "blank_timeout",
                    "x-hidden": false,
                    "type": [
                        "number",
                        "null"
                    ],
                    "x-required": false,
                    "description": "Seconds a value stays on screen before the display blanks itself. Set 0 to leave values up indefinitely. Individual set_value calls can override this.",
                    "default": 300.0,
                    "x-position": 4,
                    "minimum": 0.0
                },
                "scroll_long_text": {
                    "title": "Scroll Long Text",
                    "x-name": "scroll_long_text",
                    "x-hidden": false,
                    "type": [
                        "boolean",
                        "null"
                    ],
                    "x-required": false,
                    "description": "Show strings longer than 4 characters by scrolling them across the panel. With this off, only the first 4 characters are shown.",
                    "default": true,
                    "x-position": 5
                },
                "blink_period": {
                    "title": "Blink Period",
                    "x-name": "blink_period",
                    "x-hidden": false,
                    "type": [
                        "integer",
                        "null"
                    ],
                    "x-required": false,
                    "description": "Blink period in milliseconds, when blinking is requested.",
                    "default": 1000,
                    "x-position": 6,
                    "minimum": 250,
                    "maximum": 3000
                },
                "scroll_tick": {
                    "title": "Scroll Speed",
                    "x-name": "scroll_tick",
                    "x-hidden": false,
                    "type": [
                        "integer",
                        "null"
                    ],
                    "x-required": false,
                    "description": "Milliseconds per character step when scrolling. Lower is faster; 200 ms is comfortable to read from a distance.",
                    "default": 200,
                    "x-position": 7,
                    "minimum": 100,
                    "maximum": 1500
                },
                "safe_state_timeout": {
                    "title": "Safe State Timeout",
                    "x-name": "safe_state_timeout",
                    "x-hidden": false,
                    "type": [
                        "integer",
                        "null"
                    ],
                    "x-required": false,
                    "description": "The display's own comms-loss failsafe: if it receives nothing for this many seconds it blanks itself, so a dead Doovit cannot leave a stale number on the panel. 0 disables it. Max 60. Applying this writes the display's config registers on startup.",
                    "default": 0,
                    "x-position": 8,
                    "minimum": 0,
                    "maximum": 60
                },
                "swap_words": {
                    "title": "Swap 32-bit Word Order",
                    "x-name": "swap_words",
                    "x-hidden": false,
                    "type": [
                        "boolean",
                        "null"
                    ],
                    "x-required": false,
                    "description": "Advanced. Only needed if the display has a non-default 'Byte order' parameter saved in its flash. Symptom: numbers appear as wild or tiny values.",
                    "default": false,
                    "x-position": 9
                },
                "swap_bytes": {
                    "title": "Swap Bytes Within Registers",
                    "x-name": "swap_bytes",
                    "x-hidden": false,
                    "type": [
                        "boolean",
                        "null"
                    ],
                    "x-required": false,
                    "description": "Advanced. Companion to the above, for a display configured with byte swapping. Symptom: text renders as scrambled character pairs.",
                    "default": false,
                    "x-position": 10
                },
                "resync_interval": {
                    "title": "Resync Interval",
                    "x-name": "resync_interval",
                    "x-hidden": false,
                    "type": [
                        "number",
                        "null"
                    ],
                    "x-required": false,
                    "description": "Seconds between re-asserting the full display state. This is what restores the panel after it is power-cycled, since everything this app writes lives in the display's RAM. 0 disables resyncing.",
                    "default": 30.0,
                    "x-position": 11,
                    "minimum": 0.0
                }
            },
            "additionalElements": true,
            "required": [
                "modbus_config"
            ]
        },
        "ui_schema": {
            "displayString": "$config.app().APP_DISPLAY_NAME",
            "hidden": "$config.app().interpreter_hidden:boolean:false",
            "fullWidth": "$config.app().interpreter_full_width:boolean:false",
            "position": "$config.app().dv_app_position:number:100",
            "icon": null,
            "colour": null,
            "defaultOpen": "$config.app().dv_app_default_open:boolean",
            "type": "uiApplication",
            "name": "$config.app().APP_KEY",
            "children": {
                "displayed_value": {
                    "name": "displayed_value",
                    "type": "uiVariable",
                    "displayString": "On Display",
                    "showActivity": true,
                    "position": 10,
                    "hidden": false,
                    "varType": "string",
                    "currentValue": "$tag.app().displayed_value:string:\"\""
                },
                "displayed_colour": {
                    "name": "displayed_colour",
                    "type": "uiVariable",
                    "displayString": "Colour",
                    "showActivity": true,
                    "position": 11,
                    "hidden": false,
                    "varType": "string",
                    "currentValue": "$tag.app().displayed_colour:string:\"green\""
                },
                "seconds_until_blank": {
                    "name": "seconds_until_blank",
                    "type": "uiVariable",
                    "displayString": "Blanks In",
                    "showActivity": true,
                    "position": 12,
                    "hidden": false,
                    "varType": "float",
                    "currentValue": "$tag.app().seconds_until_blank:number:0",
                    "decPrecision": 0
                },
                "manual_message": {
                    "name": "manual_message",
                    "type": "uiTextInput",
                    "displayString": "Show A Message",
                    "position": 20,
                    "hidden": false,
                    "currentValue": "$cmds.app().manual_message",
                    "isTextArea": false
                },
                "manual_colour": {
                    "name": "manual_colour",
                    "type": "uiSelect",
                    "displayString": "Set Colour",
                    "position": 21,
                    "hidden": false,
                    "currentValue": "$cmds.app().manual_colour",
                    "options": {
                        "green": {
                            "name": "green",
                            "displayString": "Green",
                            "type": "uiElement"
                        },
                        "red": {
                            "name": "red",
                            "displayString": "Red",
                            "type": "uiElement"
                        },
                        "yellow": {
                            "name": "yellow",
                            "displayString": "Yellow",
                            "type": "uiElement"
                        }
                    }
                },
                "blank_now": {
                    "name": "blank_now",
                    "type": "uiButton",
                    "displayString": "Blank Display",
                    "position": 22,
                    "hidden": false,
                    "currentValue": "$cmds.app().blank_now"
                },
                "diagnostics": {
                    "name": "diagnostics",
                    "type": "uiSubmodule",
                    "displayString": "Diagnostics",
                    "showActivity": true,
                    "position": 90,
                    "hidden": false,
                    "children": {
                        "comms_ok": {
                            "name": "comms_ok",
                            "type": "uiVariable",
                            "displayString": "Modbus OK",
                            "showActivity": true,
                            "position": 57,
                            "hidden": false,
                            "varType": "bool",
                            "currentValue": "$tag.app().comms_ok:boolean:false"
                        },
                        "last_error": {
                            "name": "last_error",
                            "type": "uiVariable",
                            "displayString": "Last Error",
                            "showActivity": true,
                            "position": 58,
                            "hidden": false,
                            "varType": "string",
                            "currentValue": "$tag.app().last_error:string:\"\""
                        },
                        "flash_cycles_remaining": {
                            "name": "flash_cycles_remaining",
                            "type": "uiVariable",
                            "displayString": "Flash Cycles Remaining",
                            "showActivity": true,
                            "position": 59,
                            "hidden": false,
                            "varType": "float",
                            "currentValue": "$tag.app().flash_cycles_remaining:number:0",
                            "decPrecision": 0
                        }
                    }
                }
            }
        }
    }
}